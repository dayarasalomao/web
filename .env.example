# Google Analytics & Tag Manager Configuration
# Copy this file to .env.local and fill in your actual IDs

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag ID (for GTM or Google Tag)
# Format: GT-XXXXXXXXXX or GTM-XXXXXXX
# Get from: https://tagmanager.google.com/ or https://marketingplatform.google.com/
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-XXXXXXXXXX

# Google Site Verification (optional)
# Format: alphanumeric string
# Get from: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Environment
NODE_ENV=development
